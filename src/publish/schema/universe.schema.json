{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "universe.schema.json",
  "title": "Tradable universe and trading calendar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_date", "assets", "calendar"],
  "properties": {
    "schema_version": {"const": 1},
    "data_date": {"$ref": "#/$defs/date"},
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ticker", "name", "asset_class", "inception", "close", "prev_close"],
        "properties": {
          "ticker": {"$ref": "#/$defs/ticker"},
          "name": {"type": "object", "additionalProperties": false, "required": ["zh", "en"],
                   "properties": {"zh": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}}},
          "asset_class": {"enum": ["broad_equity", "sector_equity", "treasury", "credit", "real_assets", "international"]},
          "inception": {"$ref": "#/$defs/date"},
          "close": {"type": "number", "exclusiveMinimum": 0, "description": "Close on data_date; share counts use it."},
          "prev_close": {"type": ["number", "null"], "exclusiveMinimum": 0}
        }
      }
    },
    "calendar": {
      "type": "object", "additionalProperties": false, "required": ["exchange", "sessions"],
      "properties": {
        "exchange": {"const": "XNYS"},
        "sessions": {"type": "array", "minItems": 60, "items": {"$ref": "#/$defs/date"},
                     "description": "XNYS sessions from data_date onward (at least 60), for lock expiry dates in the browser."}
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "ticker": {"type": "string", "pattern": "^[A-Z]{1,5}$"}
  }
}
