{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backtest.schema.json",
  "title": "Backtest of one portfolio (strategy x ceiling)",
  "description": "Loaded only when a detail or compare page needs it. Daily series are column arrays of equal length.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "portfolio", "strategy", "ceiling", "start", "end", "dates", "equity",
               "weights", "rebalances", "metrics", "monthly_returns", "annual_returns"],
  "properties": {
    "schema_version": {"const": 1},
    "portfolio": {"type": "string", "pattern": "^[a-z0-9_]+_D\\d{1,3}$"},
    "strategy": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "ceiling": {"type": "integer", "minimum": 1, "maximum": 100},
    "start": {"$ref": "#/$defs/date"},
    "end": {"$ref": "#/$defs/date"},
    "dates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/date"}},
    "equity": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0},
               "description": "Value of 1 invested at start, at each session's close. Daily returns and drawdowns are derived in the browser."},
    "weights": {
      "type": "object", "additionalProperties": false, "required": ["assets", "dates", "values"],
      "description": "Holdings sampled weekly (and on the last session), for the holdings-over-time chart.",
      "properties": {
        "assets": {"type": "array", "minItems": 1, "uniqueItems": true,
                   "items": {"type": "string", "pattern": "^(CASH|[A-Z]{1,5})$"}},
        "dates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/date"}},
        "values": {"type": "array",
                   "items": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}},
                   "description": "values[k][j]: weight of assets[j] on dates[k]."}
      }
    },
    "rebalances": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["date", "changes"],
                "properties": {"date": {"$ref": "#/$defs/date"},
                               "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}}}}
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["cagr", "volatility", "sharpe", "max_drawdown", "calmar", "best_day", "worst_day", "up_days"],
      "properties": {
        "cagr": {"type": "number"},
        "volatility": {"type": "number", "minimum": 0},
        "sharpe": {"type": "number"},
        "max_drawdown": {"type": "number", "minimum": 0, "maximum": 1},
        "calmar": {"type": "number"},
        "best_day": {"type": "number"},
        "worst_day": {"type": "number"},
        "up_days": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "monthly_returns": {
      "type": "object", "propertyNames": {"pattern": "^\\d{4}$"},
      "additionalProperties": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": ["number", "null"]}}
    },
    "annual_returns": {"type": "object", "propertyNames": {"pattern": "^\\d{4}$"},
                       "additionalProperties": {"type": "number"}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "change": {
      "type": "object", "additionalProperties": false, "required": ["ticker", "from", "to"],
      "properties": {"ticker": {"type": "string", "pattern": "^[A-Z]{1,5}$"},
                     "from": {"type": "number", "minimum": 0, "maximum": 1},
                     "to": {"type": "number", "minimum": 0, "maximum": 1}}
    }
  }
}
