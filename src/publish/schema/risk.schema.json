{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk.schema.json",
  "title": "Stress scenarios for the in-browser rebalance",
  "description": "The risk envelope's stress samples at data_date (src/constraints/risk_envelope.py), so the real-holdings mode can apply the same rule as the backtest. Provisional until Step 6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_date", "measure", "quantile", "horizon_days", "aggregation",
               "over_budget_rule", "assets", "samples"],
  "properties": {
    "schema_version": {"const": 1},
    "data_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "measure": {"const": "cvar"},
    "quantile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "horizon_days": {"type": "integer", "minimum": 1},
    "aggregation": {"enum": ["max", "mean", "quantile"]},
    "over_budget_rule": {"enum": ["freeze", "no_risk_increase"]},
    "assets": {"type": "array", "minItems": 2, "uniqueItems": true,
               "prefixItems": [{"const": "CASH"}],
               "items": {"type": "string", "pattern": "^(CASH|[A-Z]{1,5})$"},
               "description": "Column order of every path; CASH first (its return is always 0)."},
    "samples": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "paths"],
        "properties": {
          "name": {"enum": ["rolling", "block_bootstrap", "crisis_windows"]},
          "paths": {"type": "array", "minItems": 1,
                    "items": {"type": "array", "items": {"type": "number", "minimum": -1}},
                    "description": "paths[k][j]: horizon-cumulative return of assets[j] in scenario k."}
        }
      }
    }
  }
}
