{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live.schema.json",
  "title": "Live record since launch",
  "description": "Built from the append-only log; past entries never change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "launch_date", "portfolios"],
  "properties": {
    "schema_version": {"const": 1},
    "launch_date": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}], "description": "null before launch."},
    "portfolios": {
      "type": "object", "propertyNames": {"pattern": "^[a-z0-9_]+_D\\d{1,3}$"},
      "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["date", "d1", "weights", "changes"],
      "properties": {
        "date": {"$ref": "#/$defs/date"},
        "d1": {"type": "number", "minimum": -1,
               "description": "Return over the session ending on date, of the weights recommended the session before."},
        "weights": {"type": "object", "propertyNames": {"pattern": "^(CASH|[A-Z]{1,5})$"},
                    "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1},
                    "description": "Recommended holdings at the close of date."},
        "changes": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["ticker", "from", "to"],
          "properties": {"ticker": {"type": "string", "pattern": "^[A-Z]{1,5}$"},
                         "from": {"type": "number", "minimum": 0, "maximum": 1},
                         "to": {"type": "number", "minimum": 0, "maximum": 1}}}}
      }
    }
  }
}
