{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "today.schema.json",
  "title": "Today's holdings per portfolio",
  "description": "One entry per strategy x ceiling: the strategy's simulated book at the close of data_date, and the decision taken at that close, which executes at the next session's open.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_date", "portfolios"],
  "properties": {
    "schema_version": {"const": 1},
    "data_date": {"$ref": "#/$defs/date"},
    "portfolios": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9_]+_D\\d{1,3}$"},
      "additionalProperties": {"$ref": "#/$defs/portfolio"}
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "asset": {"type": "string", "pattern": "^(CASH|[A-Z]{1,5})$"},
    "weights": {
      "type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/asset"},
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1},
      "description": "Fractions of portfolio value, nonzero entries only, summing to 1 (CASH included)."
    },
    "change": {
      "type": "object", "additionalProperties": false, "required": ["ticker", "from", "to"],
      "properties": {"ticker": {"type": "string", "pattern": "^[A-Z]{1,5}$"},
                     "from": {"type": "number", "minimum": 0, "maximum": 1},
                     "to": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "ret": {"type": ["number", "null"], "minimum": -1},
    "portfolio": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "ceiling", "weights", "current_weights", "next_trades", "drawdown",
                   "risk_state", "locks", "returns", "summary", "spark", "last_rebalance", "traded_today"],
      "properties": {
        "strategy": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "ceiling": {"type": "integer", "minimum": 1, "maximum": 100},
        "weights": {"$ref": "#/$defs/weights", "description": "The plan: target weights for the next session's open, after the lock and the risk rule."},
        "current_weights": {"$ref": "#/$defs/weights", "description": "The book at the close of data_date."},
        "next_trades": {"type": "array", "items": {"$ref": "#/$defs/change"},
                        "description": "ETFs whose weight changes from current_weights to weights by at least 0.1 percentage point."},
        "drawdown": {"type": "number", "minimum": 0, "maximum": 1},
        "risk_state": {"enum": ["normal", "over_budget", "capital_preservation"],
                       "description": "Of the plan's decision. normal: within the risk budget; over_budget: the no-risk-increase rule binds; capital_preservation: drawdown past the ceiling."},
        "locks": {"type": "object", "propertyNames": {"type": "string", "pattern": "^[A-Z]{1,5}$"},
                  "additionalProperties": {"$ref": "#/$defs/date"},
                  "description": "ETFs held at the close of data_date and still locked after it, mapped to the first session they may be sold. A purchase in next_trades relocks that ETF."},
        "returns": {
          "type": "object", "additionalProperties": false, "required": ["d1", "m1", "ytd", "y1"],
          "properties": {"d1": {"$ref": "#/$defs/ret"}, "m1": {"$ref": "#/$defs/ret"},
                         "ytd": {"$ref": "#/$defs/ret"}, "y1": {"$ref": "#/$defs/ret"}}
        },
        "summary": {
          "type": "object", "additionalProperties": false, "required": ["cagr", "sharpe", "max_drawdown"],
          "description": "Full-backtest metrics, so the overview needs no backtest file.",
          "properties": {"cagr": {"type": "number"}, "sharpe": {"type": "number"},
                         "max_drawdown": {"type": "number", "minimum": 0, "maximum": 1}}
        },
        "spark": {"type": "array", "minItems": 2, "maxItems": 60, "items": {"type": "number", "exclusiveMinimum": 0},
                  "description": "Equity over the last year at each week's last session, scaled to 1 at the first point."},
        "last_rebalance": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["date", "changes"],
             "properties": {"date": {"$ref": "#/$defs/date"},
                            "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}}}}
          ]
        },
        "traded_today": {"type": "boolean", "description": "The last rebalance executed on data_date."}
      }
    }
  }
}
